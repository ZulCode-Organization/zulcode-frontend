<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis fica em zero de propósito: quem redesenha é o app, quando
  carrega o perfil, e o relógio da virada do dia (Widgets.agendarVirada).
  A prévia do seletor tem versão clara e escura (drawable-night-nodpi).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_zulcode"
    android:previewImage="@drawable/previa_widget_semana"
    android:description="@string/widget_semana_descricao"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
